# Переменные окружения РЕСКА (скопируй в .env и заполни)
# Обязательно сгенерируй свой SESSION_SECRET:  openssl rand -hex 32

PORT=3000
NODE_ENV=production

# Пути к БД и загрузкам (внутри контейнера — том reska-data)
SPACE_DB_PATH=/data/space.db
SPACE_UPLOAD_DIR=/data/uploads

# Секрет сессий (ОБЯЗАТЕЛЬНО измени!)
SESSION_SECRET=__CHANGE_ME_STRONG_RANDOM__

# FCM push (необязательно; можно оставить пустым — работает WebSocket)
# Вставь сюда JSON-объект service account из Firebase консоли (в кавычках)
FCM_SERVICE_ACCOUNT=

# Отключить CSRF (только для локальной отладки/дебага, на проде лучше false)
CSRF_DISABLED=false

# ---- Звонки (WebRTC) — обход ограничений РКН через TURN-relay поверх TLS ----
# Публичный IP сервера (нужен coturn для корректного external-ip)
SERVER_IP=__YOUR_SERVER_PUBLIC_IP__
# STUN (свой или публичный)
STUN_URL=stun:stun.l.google.com:19302
# TURN поверх TLS. Для РКН используй порт 443 (маскировка под HTTPS).
# Укажи свой домен, на который выписан TLS-сертификат в ./certs
TURN_URL=turns:your-domain.ru:443
TURN_USER=reska
# Тот же секрет, что в coturn (--user=reska:SECRET)
TURN_SECRET=__CHANGE_ME_TURN_SECRET__
